---
import Trang from '../layouts/Trang.astro';
import { banMoiNhat, REPO_URL } from '../lib/noi-dung';

const ban = await banMoiNhat();
const buoc = [
  { t: 'Mở ứng dụng trên hai máy', d: 'Hai máy cùng một mạng Wi-Fi hoặc mạng LAN. Không cần đăng nhập, không cần Internet, không cần cáp.' },
  { t: 'Chọn tệp, chọn máy nhận', d: 'Ở thẻ Gửi, chọn tệp, thư mục, ảnh, văn bản hay nội dung bộ nhớ tạm, rồi bấm vào tên máy trong mục Thiết bị lân cận.' },
  { t: 'Bên nhận bấm Chấp nhận', d: 'Tệp đi thẳng từ máy này sang máy kia qua kết nối HTTPS được mã hóa. Không bên thứ ba nào nhìn thấy nội dung.' },
];
const tinhNang = [
  { t: 'Mọi hệ điều hành', d: 'Windows, macOS, Linux, Android, iOS. Gửi từ điện thoại sang máy tính và ngược lại như nhau.' },
  { t: 'Luôn mới nhất', d: 'Ứng dụng tự kiểm tra phiên bản khi mở; bản quá cũ được yêu cầu cập nhật để mọi máy nói cùng một giao thức.' },
  { t: 'Tệp lớn, nhiều tệp', d: 'Không giới hạn dung lượng hay số tệp. Gửi nguyên thư mục, gửi cho nhiều máy cùng lúc.' },
  { t: 'Chia sẻ qua liên kết', d: 'Máy không cài ứng dụng vẫn nhận được: mở liên kết trong trình duyệt, có thể đặt mã PIN.' },
  { t: 'Thiết bị yêu thích', d: 'Lưu máy hay dùng để gửi nhanh; chế độ Lưu nhanh chỉ tự nhận từ máy yêu thích.' },
  { t: 'Dòng lệnh', d: 'Công cụ dòng lệnh cho máy chủ không giao diện và script tự động hóa, dùng chung lõi giao thức.' },
  { t: 'Tiếng Việt mặc định', d: 'Giao diện tiếng Việt đầy đủ ngay lần mở đầu, tên thiết bị ngẫu nhiên kiểu "Xoài Thông Minh"; vẫn đổi được sang hơn 60 ngôn ngữ.' },
  { t: 'Miễn phí, không quảng cáo', d: 'Mã nguồn mở theo giấy phép Apache 2.0, không theo dõi, không thu thập dữ liệu.' },
];
const baoMat = [
  { t: 'Dữ liệu không rời mạng nội bộ', d: 'Không máy chủ trung gian, không đám mây. Tính năng cần máy chủ ngoài (WebRTC) đang tắt trong mã nguồn.' },
  { t: 'Mã hóa và xác thực hai chiều', d: 'HTTPS bật sẵn; mỗi máy có chứng thư riêng và hai bên kiểm chứng thư của nhau ngay khi bắt tay TLS.' },
  { t: 'Chống dò mã PIN', d: 'Tối đa 3 lần sai rồi chặn; bản tsudev đếm theo cả khối địa chỉ IPv6 nên đổi địa chỉ không lách được.' },
  { t: 'Kiểm tra liên tục', d: 'Mỗi thay đổi đi qua CodeQL, gitleaks, soát lỗ hổng thư viện Rust và Dart, kiểm bản dịch tiếng Việt.' },
];
---
<Trang moTa="Lotus Share: gửi tệp và tin nhắn giữa điện thoại, máy tính trong cùng mạng Wi-Fi, không cần Internet, mã hóa đầu cuối, giao diện tiếng Việt." duongDan="/">
  <section class="mo-dau">
    <div class="khung mo-dau__luoi">
      <div>
        <span class="nhan">{ban ? `Phiên bản ${ban.phienBan} · ${ban.ngay}` : 'Sắp có bản phát hành đầu tiên'}</span>
        <h1>Gửi tệp giữa các thiết bị, <span class="chu-tim">không cần Internet</span></h1>
        <p class="mo-dau__phu">Lotus Share chuyển ảnh, video, tài liệu và tin nhắn giữa điện thoại, máy tính bảng và máy tính trong cùng mạng Wi-Fi. Mã hóa, không tài khoản, không qua đám mây, giao diện tiếng Việt.</p>
        <div class="mo-dau__nut">
          <a class="nut nut--chinh" href="/tai-ve/">Tải Lotus Share</a>
          <a class="nut nut--phu" href="/huong-dan/">Xem hướng dẫn</a>
        </div>
        <p class="mo-dau__ghi-chu">Windows · macOS · Linux · Android · iOS · giấy phép Apache 2.0</p>
      </div>
      <figure class="minh-hoa">
        <img src="/anh/minh-hoa.svg" alt="Sơ đồ: điện thoại và máy tính trong cùng mạng Wi-Fi gửi tệp trực tiếp cho nhau qua kết nối có khóa, không qua Internet" width="640" height="420">
        <figcaption>Tệp đi thẳng giữa hai máy trong mạng nội bộ</figcaption>
      </figure>
    </div>
  </section>

  <section class="muc" aria-labelledby="cach-dung">
    <div class="khung">
      <h2 id="cach-dung">Ba bước là xong</h2>
      <p class="muc__dan">Không cài đặt máy chủ, không cấu hình mạng. Hai máy tự tìm thấy nhau.</p>
      <ol class="buoc">
        {buoc.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="muc" aria-labelledby="tinh-nang">
    <div class="khung">
      <h2 id="tinh-nang">Tính năng</h2>
      <p class="muc__dan">Tiếng Việt từ đầu, nhiều lớp bảo vệ, chạy trên mọi nền tảng.</p>
      <ul class="the-luoi">
        {tinhNang.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="bao-mat">
    <div class="khung">
      <h2 id="bao-mat">Riêng tư và an toàn</h2>
      <p class="muc__dan">Mô hình mối đe dọa và từng lớp phòng thủ ở trang <a href="/bao-mat/kien-truc/">Kiến trúc bảo mật</a>.</p>
      <ul class="the-luoi">
        {baoMat.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="nguon-goc">
    <div class="khung">
      <h2 id="nguon-goc">Mã nguồn mở</h2>
      <p class="muc__dan">Toàn bộ mã nguồn Lotus Share công khai trên GitHub theo giấy phép Apache 2.0. Mọi bản phát hành được build tự động từ mã nguồn, ký SHA256SUMS bằng Sigstore và kèm chứng thực nguồn gốc SLSA.</p>
      <div class="mo-dau__nut">
        <a class="nut nut--phu" href={REPO_URL} target="_blank" rel="noopener noreferrer">Mã nguồn trên GitHub</a>
        <a class="nut nut--phu" href="/ban-quyen/">Bản quyền</a>
      </div>
    </div>
  </section>
</Trang>
