---
import TaiLieu from '../components/TaiLieu.astro';
import { changelogMoiNhat, RELEASES_URL, renderMd } from '../lib/noi-dung';
// Sáu phiên bản gần nhất; bản đầy đủ ở CHANGELOG.md trên GitHub.
const { html } = renderMd('CHANGELOG.md', { md: changelogMoiNhat(6), haCap: 0 });
---
<TaiLieu tieuDe="Nhật ký thay đổi" moTa="Nhật ký thay đổi của Lotus Share theo từng phiên bản: tính năng mới, sửa lỗi, bản vá bảo mật và thay đổi giao thức cần biết khi cập nhật." duongDan="/nhat-ky/" nguon="CHANGELOG.md">
  <h1>Nhật ký thay đổi</h1>
  <p>Sáu phiên bản gần nhất. Chi tiết từng bản ở <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">trang phát hành trên GitHub</a>.</p>
  <div><Fragment set:html={html} /></div>
</TaiLieu>
