---
import Trang from '../layouts/Trang.astro';
import { banMoiNhat, goiNhanh, NEN_TANG, RELEASES_URL, REPO, REPO_URL } from '../lib/noi-dung';

const ban = await banMoiNhat();
const mb = (b: number) => `${(b / 1024 / 1024).toFixed(1).replace('.', ',')} MB`;
const theoNenTang = NEN_TANG.map((nt) => ({ ...nt, goi: ban?.goi.filter((g) => g.nenTang === nt.ma) ?? [] })).filter((nt) => nt.goi.length > 0);
const laBoCaiWin = (ten: string) => /-windows-x86-64(-setup)?\.exe$/.test(ten) && !ten.includes('-cli-');
const vd = ban?.goi.find((g) => laBoCaiWin(g.ten))?.ten ?? 'lotus-share-<phiên bản>-windows-x86-64-setup.exe';
const nhanh = goiNhanh(ban);
const nhanhChinh = nhanh.slice(0, 4);
const nhanhPhu = nhanh.slice(4);
---
<Trang tieuDe="Tải về" moTa="Tải Lotus Share cho Windows, macOS, Linux và Android; mã SHA-256 của từng gói, cách kiểm tra tệp tải về và hướng dẫn cài đặt từng hệ điều hành." duongDan="/tai-ve/">
  <div class="khung tai-lieu">
    <nav class="tai-lieu__menu" aria-label="Tải về">
      <p>Tải về</p>
      <ul>
        <li><a href="#tai-nhanh">Tải nhanh</a></li>
        <li><a href="#cai-bang-lenh">Cài bằng lệnh</a></li>
        <li><a href="#chon-goi">Chọn gói</a></li>
        <li><a href="#kiem-tra">Kiểm tra tệp</a></li>
        <li><a href="#windows">Cài trên Windows</a></li>
        <li><a href="#macos">Cài trên macOS</a></li>
        <li><a href="#linux">Cài trên Linux</a></li>
        <li><a href="#android">Cài trên Android</a></li>
        <li><a href="#khong-thay-nhau">Không thấy thiết bị?</a></li>
        <li><a href="#chuyen-doi">Đã cài bản tsudev-lotus?</a></li>
      </ul>
    </nav>
    <article class="van-ban">
      {ban ? (
        <>
          <h1>Tải Lotus Share {ban.phienBan}</h1>
          <p>Phát hành ngày {ban.ngay}. Mọi gói được GitHub Actions build từ mã nguồn công khai; trang này chỉ dẫn tới <a href={ban.url} target="_blank" rel="noopener noreferrer">trang phát hành trên GitHub</a>, không lưu bản sao.</p>
        </>
      ) : (
        <>
          <h1>Tải Lotus Share</h1>
          <div class="chu-y">
            <p><strong>Bản phát hành đầu tiên đang được chuẩn bị.</strong> Khi có, danh sách gói kèm mã SHA-256 sẽ hiện ngay tại đây và ở <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">trang phát hành trên GitHub</a>.</p>
            <p>Trong lúc chờ, bạn có thể tự build từ <a href={REPO_URL} target="_blank" rel="noopener noreferrer">mã nguồn</a> (cần Flutter 3.47.9 và Rust), hoặc theo dõi repo trên GitHub (Watch, chọn Releases) để được báo khi có bản mới.</p>
          </div>
        </>
      )}

      {nhanh.length > 0 && (
        <>
          <h2 id="tai-nhanh">Tải nhanh</h2>
          <p>Một tệp cho mỗi hệ điều hành, đủ dùng cho hầu hết máy. Đường dẫn ngắn luôn trỏ tới bản mới nhất, tiện gửi cho người khác hoặc in mã QR.</p>
          <div class="goi">
            {nhanhChinh.map((n) => (
              <div class="goi__muc">
                <div>
                  <p class="goi__loai">{n.nhan}</p>
                  <p class="goi__ten">{n.moTa} · {mb(n.goi.kichThuoc)} · <code>lotus.tsudev.com/tai/{n.ma}</code></p>
                </div>
                <a class="nut nut--chinh" href={n.goi.url}>Tải về<span class="an-di"> cho {n.nhan}</span></a>
              </div>
            ))}
          </div>
          {nhanhPhu.length > 0 && <p>Khác: {nhanhPhu.map((n, i) => (<>{i > 0 && ', '}<a href={n.goi.url}>{n.nhan}</a> (<code>/tai/{n.ma}</code>)</>))}. Đủ mọi gói kèm SHA-256 ở mục <a href="#chon-goi">Chọn gói</a>.</p>}
        </>
      )}

      <h2 id="cai-bang-lenh">Cài bằng lệnh</h2>
      <p>Cách nhanh nhất, tự cập nhật về sau. Gói do chính dự án duy trì, ghim mã SHA-256 của bản phát hành; trình quản lý gói từ chối cài nếu tệp không khớp.</p>
      <h3>Windows - Scoop</h3>
      <pre tabindex="0"><code>scoop bucket add tsudev https://github.com/tsudev-org/scoop-bucket
scoop install tsudev/lotus-share</code></pre>
      <h3>macOS - Homebrew</h3>
      <pre tabindex="0"><code>brew install --cask tsudev-org/tap/lotus-share</code></pre>
      <h3>Debian, Ubuntu, Mint - APT</h3>
      <pre tabindex="0"><code>curl -fsSL https://pkg.tsudev.com/tsudev-archive-keyring.gpg | sudo tee /usr/share/keyrings/tsudev.gpg &gt;/dev/null
echo "deb [signed-by=/usr/share/keyrings/tsudev.gpg] https://pkg.tsudev.com/apt stable main" | sudo tee /etc/apt/sources.list.d/tsudev.list
sudo apt update &amp;&amp; sudo apt install lotus-share</code></pre>
      <h3>Fedora - DNF</h3>
      <pre tabindex="0"><code>sudo curl -fsSLo /etc/yum.repos.d/tsudev.repo https://pkg.tsudev.com/rpm/tsudev.repo
sudo dnf install lotus-share</code></pre>
      <p>Kho APT/RPM ký GPG, vân tay khóa <code>3883 10F4 7FA8 224D 76C0  A9C7 9745 B6AF 3EA3 3C74</code> (đối chiếu tại <a href="https://tsudev.com/apps" target="_blank" rel="noopener noreferrer">tsudev.com/apps</a>); apt và dnf tự từ chối gói không khớp chữ ký. Gói cài vào <code>/opt/lotus-share</code>, lệnh <code>lotus-share</code>, gỡ sạch bằng <code>sudo apt remove lotus-share</code> / <code>sudo dnf remove lotus-share</code>.</p>
      <p>Mã nguồn gói: <a href="https://github.com/tsudev-org/scoop-bucket" target="_blank" rel="noopener noreferrer">tsudev-org/scoop-bucket</a>, <a href="https://github.com/tsudev-org/homebrew-tap" target="_blank" rel="noopener noreferrer">tsudev-org/homebrew-tap</a>, <a href="https://github.com/tsudev-org/linux-packages" target="_blank" rel="noopener noreferrer">tsudev-org/linux-packages</a>. Gói winget đang chờ Microsoft duyệt.</p>

      <h2 id="chon-goi">Chọn gói</h2>
      {theoNenTang.length > 0 ? (
        <div class="goi">
          {theoNenTang.map((nt) => (
            <section class="goi__nhom" aria-labelledby={`goi-${nt.ma}`}>
              <h3 id={`goi-${nt.ma}`}>{nt.ten}</h3>
              {nt.goi.map((g) => (
                <div class="goi__muc">
                  <div>
                    <p class="goi__loai">{g.loai}</p>
                    <p class="goi__ten">{g.ten} · {mb(g.kichThuoc)}</p>
                  </div>
                  <a class={`nut ${laBoCaiWin(g.ten) ? 'nut--chinh' : 'nut--phu'}`} href={g.url}>Tải về<span class="an-di"> {g.ten}</span></a>
                  {g.sha256 && <p class="goi__bam">SHA-256: {g.sha256}</p>}
                </div>
              ))}
            </section>
          ))}
        </div>
      ) : (
        <div class="bang" tabindex="0" role="region" aria-label="Các gói sẽ có, cuộn ngang được">
          <table>
            <thead><tr><th scope="col">Hệ điều hành</th><th scope="col">Gói</th></tr></thead>
            <tbody>
              <tr><td>Windows 10/11 x64</td><td><code>-windows-x86-64-setup.exe</code> (bộ cài) hoặc <code>.zip</code> (di động)</td></tr>
              <tr><td>Windows 11 ARM64</td><td><code>-windows-arm-64.zip</code></td></tr>
              <tr><td>macOS 12+</td><td><code>.dmg</code> (chip Apple và Intel)</td></tr>
              <tr><td>Linux x64</td><td><code>.AppImage</code>, <code>.tar.gz</code> - hoặc cài <code>.deb</code> / <code>.rpm</code> từ kho APT/RPM (mục <a href="#cai-bang-lenh">Cài bằng lệnh</a>)</td></tr>
              <tr><td>Android 5.0+</td><td><code>.apk</code></td></tr>
            </tbody>
          </table>
        </div>
      )}
      <p>Không chắc máy Windows dùng bản nào? Mở <strong>Cài đặt, Hệ thống, Giới thiệu</strong>, xem dòng <em>Loại hệ thống</em>. Phần lớn máy dùng bản <strong>x64</strong>.</p>

      <h2 id="kiem-tra">Kiểm tra tệp trước khi chạy</h2>
      <p>So mã SHA-256 của tệp bạn tải với mã ghi ở trên (hoặc trong tệp <code>SHA256SUMS.txt</code> của bản phát hành). Tệp <code>SHA256SUMS.txt</code> được ký bằng Sigstore và mọi gói có chứng thực nguồn gốc bản build (SLSA), nên bạn kiểm được gói đến từ đúng quy trình phát hành của repo này: xem <a href={`${REPO_URL}/blob/main/docs/vi/PHAT-HANH.md#4-người-dùng-kiểm-chứng-tệp-tải-về`} target="_blank" rel="noopener noreferrer">hướng dẫn kiểm chứng</a>.</p>
      <p>Cách bản phát hành được build và ký: <a href="/chinh-sach-ky-ma/">Chính sách ký mã (Code signing policy)</a>.</p>
      <p>Windows (PowerShell):</p>
      <pre tabindex="0"><code>Get-FileHash .\{vd} -Algorithm SHA256</code></pre>
      <p>macOS, Linux:</p>
      <pre tabindex="0"><code>sha256sum lotus-share-*.AppImage     # macOS: shasum -a 256 lotus-share-*.dmg</code></pre>
      <div class="chu-y">
        <p><strong>Chỉ tải từ trang này hoặc từ <a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer">github.com/{REPO}</a>.</strong> Mọi trang khác tự xưng "bản chính thức" đều không liên quan tới tsudev.</p>
        <p>Bản Windows hiện chưa có chứng thư ký mã nên SmartScreen có thể cảnh báo ở lần chạy đầu: chọn <em>Thông tin thêm</em>, rồi <em>Vẫn chạy</em> sau khi đã kiểm SHA-256.</p>
      </div>

      <h2 id="windows">Cài trên Windows 10/11</h2>
      <ol>
        <li>Chạy bộ cài <code>-setup.exe</code> và giữ dấu chọn <strong>Cho phép Lotus Share qua Tường lửa Windows</strong> (mặc định): bộ cài tự tạo quy tắc cho phép, xóa quy tắc chặn cũ, và tự gỡ bản <em>tsudev-lotus</em> cũ nếu có. Gỡ cài đặt sẽ xóa sạch các quy tắc này.</li>
        <li>Bản di động <code>.zip</code>: giải nén vào một thư mục cố định rồi chạy <code>lotus_share.exe</code>. Lần chạy đầu, Tường lửa Windows hỏi quyền: đánh dấu <strong>cả hai</strong> loại mạng rồi bấm Cho phép. Lỡ bấm Hủy thì chạy công cụ chẩn đoán bên dưới để sửa.</li>
        <li>Không thấy thiết bị khác: mở menu Start, chạy <strong>Lotus Share - Sửa lỗi kết nối</strong> (bản .zip: nhấp phải <code>chan-doan-mang.ps1</code>, chọn <em>Run with PowerShell</em>). Công cụ kiểm tường lửa, loại mạng, card mạng ảo/VPN, quét mạng tìm thiết bị đang mở Lotus Share, rồi đề nghị sửa.</li>
      </ol>

      <h2 id="macos">Cài trên macOS 12 trở lên</h2>
      <ol>
        <li>Mở tệp <code>.dmg</code>, kéo ứng dụng vào thư mục Applications.</li>
        <li>Bản build chưa được Apple công chứng (notarize). Lần mở đầu, vào <strong>Cài đặt hệ thống, Quyền riêng tư và bảo mật</strong>, chọn <strong>Vẫn mở</strong>.</li>
        <li>Khi được hỏi quyền <em>Mạng cục bộ</em>, chọn Cho phép.</li>
      </ol>

      <h2 id="linux">Cài trên Linux</h2>
      <pre tabindex="0"><code>chmod +x lotus-share-&lt;phiên bản&gt;-linux-x86-64.AppImage
./lotus-share-&lt;phiên bản&gt;-linux-x86-64.AppImage
# hoặc cài từ kho APT/RPM để tự cập nhật: xem mục "Cài bằng lệnh"</code></pre>
      <p>Có tường lửa (ufw, firewalld)? Mở cổng 53420 cho TCP và UDP trong mạng nội bộ: <code>sudo ufw allow from 192.168.0.0/16 to any port 53420</code>.</p>

      <h2 id="android">Cài trên Android</h2>
      <ol>
        <li>Tải tệp <code>.apk</code> trên điện thoại, mở tệp và cho phép <em>Cài ứng dụng không rõ nguồn gốc</em> cho trình duyệt.</li>
        <li>Cấp quyền truy cập ảnh/tệp khi được hỏi để gửi và lưu tệp.</li>
      </ol>
      <p>Mọi APK ký bằng khóa của tsudev. Dấu vân tay SHA-256 của chứng thư ký (đối chiếu bằng <code>apksigner verify --print-certs</code>):</p>
      <pre tabindex="0"><code>ad1be603b39b0c211c3ac4c4f890e1c85509209807a029380738089399be1f45</code></pre>
      <p>Mã định danh ứng dụng là <code>com.tsudev.lotusshare</code>.</p>

      <h2 id="khong-thay-nhau">Mở ứng dụng trên cả hai máy mà không thấy nhau?</h2>
      <p>Lotus Share tìm thiết bị bằng gói tin multicast và broadcast trong mạng nội bộ, rồi quét cả mạng sau 1 giây để tìm máy mà gói tin không tới được. Kiểm tra lần lượt:</p>
      <ol>
        <li><strong>Cùng một mạng</strong>: điện thoại và máy tính nối cùng Wi-Fi (không phải Wi-Fi khách, không dùng dữ liệu di động). Một số bộ phát tách băng tần 2,4 GHz và 5 GHz thành hai mạng.</li>
        <li><strong>Cùng phiên bản</strong>: mọi thiết bị cần chạy Lotus Share 2.0 trở lên (giao thức riêng từ 2.0). Bản cũ hơn sẽ được yêu cầu cập nhật khi mở.</li>
        <li><strong>Windows</strong>: chạy <em>Lotus Share - Sửa lỗi kết nối</em> trong menu Start. Hay gặp nhất: tường lửa chặn vì mạng đặt là Công cộng, hoặc từng bấm Hủy ở hộp thoại tường lửa.</li>
        <li><strong>Linux</strong>: tường lửa ufw (Linux Mint) hoặc firewalld (Fedora) chặn kết nối đến. Trong ứng dụng: Cài đặt &gt; Khắc phục sự cố &gt; <em>Sửa lỗi tự động</em>; hoặc chạy <code>bash chan-doan-mang.sh --sua</code> trong thư mục giải nén gói tar.gz.</li>
        <li><strong>Android</strong>: cấp quyền <em>Thiết bị ở gần</em> / <em>Mạng cục bộ</em> khi được hỏi; tắt chế độ tiết kiệm pin cho Lotus Share; tắt VPN hoặc DNS riêng chặn mạng nội bộ.</li>
        <li><strong>Wi-Fi cơ quan, quán cà phê</strong> thường bật <em>cách ly thiết bị</em>: các máy không nói chuyện được với nhau. Cách nhanh nhất: bật điểm phát Wi-Fi trên điện thoại cho máy tính kết nối vào.</li>
        <li>Vẫn không thấy: trên một máy, ở tab Gửi chọn <strong>Gửi thủ công</strong> và nhập địa chỉ IP hiện ở tab Nhận của máy kia.</li>
      </ol>

      <h2 id="chuyen-doi">Đã cài bản tsudev-lotus?</h2>
      <p>Từ ngày 11/11/2026 ứng dụng đổi tên thành <strong>Lotus Share</strong> với định danh mới (<code>com.tsudev.lotusshare</code>), nên hệ điều hành coi đây là một ứng dụng khác: bản cũ <strong>không tự cập nhật</strong> sang Lotus Share.</p>
      <ol>
        <li>Cài Lotus Share theo hướng dẫn ở trên.</li>
        <li>Gỡ bản cũ tên <em>tsudev-lotus</em> (Windows: bộ cài Lotus Share từ bản sau 1.18.2-lotus.4 tự gỡ, hoặc Cài đặt &gt; Ứng dụng; Android: giữ biểu tượng &gt; Gỡ cài đặt; macOS: kéo vào Thùng rác; Linux: xóa tệp AppImage cũ).</li>
        <li>Đã cài bằng lệnh: APT, DNF và Homebrew tự chuyển sang Lotus Share khi cập nhật (<code>sudo apt upgrade</code>, <code>sudo dnf upgrade</code>, <code>brew upgrade</code>); sau đó gỡ gói chuyển tiếp nếu muốn (<code>sudo apt remove tsudev-lotus</code>). Scoop: <code>scoop uninstall tsudev-lotus</code> rồi <code>scoop install tsudev/lotus-share</code>.</li>
        <li>Thiết bị yêu thích và cài đặt không chuyển sang được: thêm lại thiết bị yêu thích và so dấu vân tay trên hai máy.</li>
      </ol>
    </article>
  </div>
</Trang>
