.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- 8. Công cụ AI & agent (có thể chứa ngữ cảnh/khóa riêng) ---
.claude/settings.local.json
.claude/local/
.cursor/rules.local.md
.aider*
.continue/
.codeium/
CLAUDE.local.md

# --- 9. Dữ liệu cục bộ, cá nhân & kết quả kiểm thử ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdf
*.ldf
dump.rdb
*.dump
*.sql.gz
*.bak.sql
data/local/
data/private/
uploads/
