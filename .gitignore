packages/*/obj/

# --- 6. Log & file tạm ---
*.log
logs/*.log
logs/*.tmp
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
scratch/
.scratch/
*.swp
*.swo
*.bak
*.orig
*.rej
*~
.#*
\#*#

# --- 7. IDE, công cụ & hệ điều hành ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
