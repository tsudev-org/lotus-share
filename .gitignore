.ruff_cache/
.cache/
.parcel-cache/
.vite/
.next/
.nuxt/
.svelte-kit/
.astro/
.turbo/
.nx/cache/
.gradle/
.dart_tool/
.pub-cache/
Pods/
vcpkg_installed/
CMakeFiles/
CMakeCache.txt
cmake-build-*/
