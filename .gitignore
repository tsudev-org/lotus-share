crash-*.log

# Bổ sung cho project Mobile (Flutter / React Native / Android / iOS)
# Đặt SAU nội dung base.gitignore
.flutter-plugins
.flutter-plugins-dependencies
.packages
.metadata
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
local.properties
captures/
.externalNativeBuild/
.cxx/
*.hmap
*.xcuserstate
xcuserdata/
DerivedData/
*.mobileprovision
*.certSigningRequest
android/key.properties
android/app/upload-keystore.jks

# Bổ sung cho project Rust - đặt SAU nội dung base.gitignore
# base.gitignore đã có target/ ; phần dưới là những thứ riêng của Rust.

# --- Bản build và tạo phẩm ---
**/target/
**/*.rs.bk
*.pdb

# --- Cargo ---
# Cargo.lock: COMMIT với binary/ứng dụng (bản build tái lập được),
# BỎ QUA với thư viện. Bỏ dấu # ở dòng dưới nếu crate này là thư viện.
# Cargo.lock
.cargo/config.toml
.cargo/credentials
.cargo/credentials.toml

# --- Công cụ ---
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
/criterion/
flamegraph.svg
perf.data*

# --- Tauri (nếu dùng, theo LANGUAGE_SELECTION.md mục 2.3) ---
src-tauri/target/
src-tauri/WixTools/
src-tauri/.tauri/
# Khóa ký bản cập nhật - LỘ LÀ MẤT QUYỀN KIỂM SOÁT KÊNH CẬP NHẬT
*.tauri.key
tauri.conf.local.json

# --- WebAssembly ---
pkg/
wasm-pack.log

# tsudev-lotus: website sản phẩm
/website/node_modules/
/website/dist/
/website/.astro/
/website/.wrangler/

# tsudev-lotus: ngoại lệ - các mẫu chuẩn `core`, `build/`, `bin/` ở trên vô tình khớp thư mục MÃ NGUỒN của repo
# (lõi Rust packages/core, tài nguyên đóng gói support/build, công cụ cargokit). Thiếu các dòng này thì tệp
# mới thêm vào đó bị git bỏ qua im lặng.
!/packages/core/
!/support/build/
!/packages/localsend_isolates/rust_builder/cargokit/build_tool/bin/
