; lotus-share: lưu UTF-8 CÓ BOM - ISCC đọc tệp không BOM theo bảng mã ANSI, chữ Việt trong [CustomMessages] sẽ hỏng.
; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Copy the contents of the zip to D:\inno, then run this Inno script
; Copy app/assets/packaging/logo.ico to D:\inno\logo.ico

; Payload/output directories, overridable from CI via /DPayloadDir=... /DResultDir=...
#ifndef PayloadDir
  #define PayloadDir "D:\inno"
#endif
#ifndef ResultDir
  #define ResultDir "D:\inno-result"
#endif

#define MyAppName "Lotus Share"
#define MyAppVersion "2.0.0"
#define MyAppPublisher "tsudev"
#define MyAppURL "https://lotus.tsudev.com"
#define MyAppExeName "lotus_share.exe"
; lotus-share: tên quy tắc Tường lửa Windows (bộ cài tạo, gỡ cài đặt xóa) và công cụ chẩn đoán mạng đi kèm.
#define MyFirewallRule "Lotus Share"
#define MyNetDoctor "chan-doan-mang.ps1"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
; lotus-share: AppId riêng (đổi 12/11/2026 khi đổi tên Lotus Share; bản tsudev-lotus cũ dùng E6A866CD-...).
AppId={{21D09887-EE8E-478B-B43F-BD492DE6EFE3}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL=https://github.com/tsudev-org/lotus-share/releases/latest
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only.)
;PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir={#ResultDir}
OutputBaseFilename=lotus-share-setup
SetupIconFile={#PayloadDir}\logo.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma
SolidCompression=yes
WizardStyle=modern
; lotus-share: luôn chọn sẵn tiếng Việt, vẫn cho đổi ngôn ngữ ở hộp thoại đầu
LanguageDetectionMethod=none
ShowLanguageDialog=yes
; Sign at compile time: the uninstaller is embedded during compilation, so signing the finished
; installer afterwards would leave it unsigned. CI defines the command via "iscc /SMySignTool=...";
; deliberately unsigned builds pass /DSkipSignTool.
#ifndef SkipSignTool
SignTool=MySignTool
#endif
; lotus-share: bộ cài Windows ARM64 riêng (iscc /DArm64); AppId giữ chung, nên đổi kiến trúc = cài đè đúng chỗ.
#ifdef Arm64
ArchitecturesInstallIn64BitMode=arm64
ArchitecturesAllowed=arm64
#else
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
#endif

[Languages]
; lotus-share: tiếng Việt đứng đầu = mặc định (vendored như Icelandic, xem ..\build\windows\inno\NGUON-VIETNAMESE.md)
Name: "vietnamese"; MessagesFile: "..\build\windows\inno\Vietnamese.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "armenian"; MessagesFile: "compiler:Languages\Armenian.isl"
Name: "brazilianportuguese"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"
Name: "bulgarian"; MessagesFile: "compiler:Languages\Bulgarian.isl"
Name: "catalan"; MessagesFile: "compiler:Languages\Catalan.isl"
Name: "corsican"; MessagesFile: "compiler:Languages\Corsican.isl"
Name: "czech"; MessagesFile: "compiler:Languages\Czech.isl"
Name: "danish"; MessagesFile: "compiler:Languages\Danish.isl"
Name: "dutch"; MessagesFile: "compiler:Languages\Dutch.isl"
Name: "finnish"; MessagesFile: "compiler:Languages\Finnish.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"
Name: "hebrew"; MessagesFile: "compiler:Languages\Hebrew.isl"
Name: "hungarian"; MessagesFile: "compiler:Languages\Hungarian.isl"
; Icelandic was reclassified as unofficial in Inno Setup 6.5.0 (no maintainer) and is no longer bundled, so it is vendored like ChineseSimplified
Name: "icelandic"; MessagesFile: "..\build\windows\inno\Icelandic.isl"
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"
Name: "norwegian"; MessagesFile: "compiler:Languages\Norwegian.isl"
Name: "polish"; MessagesFile: "compiler:Languages\Polish.isl"
Name: "portuguese"; MessagesFile: "compiler:Languages\Portuguese.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"
Name: "slovak"; MessagesFile: "compiler:Languages\Slovak.isl"
Name: "slovenian"; MessagesFile: "compiler:Languages\Slovenian.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"
Name: "ukrainian"; MessagesFile: "compiler:Languages\Ukrainian.isl"
Name: "chinesesimplified"; MessagesFile: "..\build\windows\inno\ChineseSimplified.isl"

[CustomMessages]
; lotus-share: mặc định tiếng Anh cho mọi ngôn ngữ, tiếng Việt ghi đè.
FirewallTask=Allow Lotus Share through Windows Firewall so phones and other computers can find this PC (recommended)
FirewallGroup=Network:
FirewallStatus=Configuring Windows Firewall...
NetDoctorName=Lotus Share - Fix connection problems
vietnamese.FirewallTask=Cho phép Lotus Share qua Tường lửa Windows để điện thoại và máy khác tìm thấy máy này (khuyến nghị)
vietnamese.FirewallGroup=Mạng:
vietnamese.FirewallStatus=Đang cấu hình Tường lửa Windows...
vietnamese.NetDoctorName=Lotus Share - Sửa lỗi kết nối

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; lotus-share: không có quy tắc cho phép, Windows chặn kết nối đến (nhất là mạng đặt "Công cộng") nên điện thoại
; không thấy máy tính. Chỉ làm được khi cài với quyền quản trị (cài cho mọi người dùng).
Name: "firewall"; Description: "{cm:FirewallTask}"; GroupDescription: "{cm:FirewallGroup}"; Check: IsAdminInstallMode

[Files]
Source: "{#PayloadDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PayloadDir}\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PayloadDir}\data\*"; DestDir: "{app}\data"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyNetDoctor}"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}";
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
; lotus-share: lối tắt công cụ chẩn đoán + sửa lỗi kết nối (tường lửa, loại mạng, card mạng ảo, cổng 53420).
Name: "{autoprograms}\{cm:NetDoctorName}"; Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\{#MyNetDoctor}"""; IconFilename: "{app}\{#MyAppExeName}"

[Run]
; lotus-share: xóa MỌI quy tắc cũ gắn với tệp chương trình trước (kể cả quy tắc "Chặn" Windows tự tạo khi người dùng
; bấm Hủy ở hộp thoại tường lửa - quy tắc chặn thắng quy tắc cho phép), rồi cho phép vào TCP + UDP ở mọi loại mạng.
; Cổng không cố định trong quy tắc vì người dùng đổi được cổng trong Cài đặt.
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=all program=""{app}\{#MyAppExeName}"""; StatusMsg: "{cm:FirewallStatus}"; Flags: runhidden; Tasks: firewall
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""{#MyFirewallRule}"" dir=in action=allow program=""{app}\{#MyAppExeName}"" protocol=TCP profile=any enable=yes"; StatusMsg: "{cm:FirewallStatus}"; Flags: runhidden; Tasks: firewall
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""{#MyFirewallRule}"" dir=in action=allow program=""{app}\{#MyAppExeName}"" protocol=UDP profile=any enable=yes"; StatusMsg: "{cm:FirewallStatus}"; Flags: runhidden; Tasks: firewall
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; lotus-share: gỡ cài đặt xóa sạch quy tắc tường lửa gắn với tệp chương trình.
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=all program=""{app}\{#MyAppExeName}"""; Flags: runhidden; RunOnceId: "LotusShareFirewall"; Check: IsAdminInstallMode

[Code]
// lotus-share: chuyển từ bản cũ "tsudev-lotus" (đổi tên 12/11/2026, AppId khác nên Inno không tự cài đè). Hai bản
// cùng chạy thì tranh cổng 53420 và bản mở sau không bật được máy chủ nhận tệp => các thiết bị không thấy nhau.
const
  LegacyUninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{E6A866CD-B32E-4718-9EF0-CE04D53F9263}_is1';
  RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';

procedure RemoveLegacyFrom(RootKey: Integer);
var
  Cmd: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(RootKey, LegacyUninstallKey, 'UninstallString', Cmd) then
  begin
    Cmd := RemoveQuotes(Cmd);
    if FileExists(Cmd) then
    begin
      Log('Gỡ bản cũ tsudev-lotus: ' + Cmd);
      Exec(Cmd, '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
      Log('Mã kết thúc trình gỡ bản cũ: ' + IntToStr(ResultCode));
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
begin
  if CurStep = ssInstall then
  begin
    Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM tsudev_lotus.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    if IsAdminInstallMode then
      RemoveLegacyFrom(HKLM);
    RemoveLegacyFrom(HKCU);
    // Tự khởi động của bản cũ (trình gỡ của nó không xóa).
    RegDeleteValue(HKCU, RunKey, 'tsudev-lotus');
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // Ứng dụng tự ghi khóa tự khởi động (Cài đặt > Tự khởi động); gỡ cài đặt thì xóa để không còn lối tắt chết.
  if CurUninstallStep = usPostUninstall then
    RegDeleteValue(HKCU, RunKey, 'lotus-share');
end;
