		<string>sr-Cyrl</string>
		<string>sv</string>
		<string>ta</string>
		<string>th</string>
		<string>tr</string>
		<string>uk</string>
		<string>ur</string>
		<string>uz</string>
		<string>vi</string>
		<string>zh-CN</string>
		<string>zh-HK</string>
		<string>zh-TW</string>
	</array>

    <!-- Make downloaded files visible to the user -->
    <key>UISupportsDocumentBrowser</key>
    <true/>

    <!-- Permissions -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Ứng dụng cần quyền truy cập thư viện ảnh để bạn chọn ảnh, video muốn chia sẻ.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Ứng dụng lưu ảnh, video nhận được vào thư viện ảnh.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Ứng dụng cần địa chỉ IP trong mạng nội bộ để kết nối với thiết bị khác.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Ứng dụng cần địa chỉ IP trong mạng nội bộ để kết nối với thiết bị khác.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Ứng dụng dùng mạng nội bộ để tìm và kết nối với các thiết bị ở gần.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_bonjour._tcp</string>
        <string>_lnp._tcp.</string>
    </array>

    <!-- share_handler -->
    <key>FlutterDeepLinkingEnabled</key>
    <false/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            </array>
        </dict>
    </array>

    <!-- Make documents files visible to the Finder/AppleDevices app -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
